# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# PIN sign-in accounts: each member's email, comma-separated, tried in order.
# Each should match that member's household_members.email.
# Older per-member VITE_*_EMAIL vars are still read when this is unset; move
# them into this list in your host env, the fallback will be removed.
VITE_MEMBER_EMAILS=member1@example.com,member2@example.com

# Web Push (server-sent reminders). Public VAPID key; leave empty to have the
# open app send pushes itself instead.
VITE_VAPID_PUBLIC_KEY=
