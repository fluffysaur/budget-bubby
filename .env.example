# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# PIN sign-in accounts. Each partner slot is identified by its email, which
# should match that member's household_members.email.
# Legacy names VITE_YIJIA_EMAIL / VITE_RACHEL_EMAIL are still read as a
# fallback during rollout; rename them in your host env, they will be removed.
VITE_PARTNER1_EMAIL=partner1@example.com
VITE_PARTNER2_EMAIL=partner2@example.com

# Web Push (server-sent reminders). Public VAPID key; leave empty to have the
# open app send pushes itself instead.
VITE_VAPID_PUBLIC_KEY=
